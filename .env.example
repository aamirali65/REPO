# Copy to .env and fill in your GitHub App values.
# Create/configure the app at https://github.com/settings/apps

# Public client ID — visible to browsers (safe to commit or share).
VITE_GITHUB_CLIENT_ID=your_github_app_client_id

# Server-only client secret — read by the Vite dev/preview proxy in vite.config.ts.
# Generate at https://github.com/settings/apps -> your app -> General -> Client secrets.
# Do NOT prefix with VITE_ (that would ship it to the browser). Keep it out of git.
GITHUB_CLIENT_SECRET=your_github_app_client_secret